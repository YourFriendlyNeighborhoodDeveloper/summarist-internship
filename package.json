  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
