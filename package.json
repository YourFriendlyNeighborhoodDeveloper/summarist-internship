{
  "name": "summarist-internship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-summarist \"playwright test\"",
